---
// Inline footnote popover. Pure HTML + CSS (popover API), no JS.
import { nextId } from "./footnote-id.js";
const id = `pop-${nextId()}`;
const anchor = `--${id}`;
---

<span class="footnote-wrapper">
	<button
		popovertarget={id}
		style={`anchor-name: ${anchor}`}
		class="link-button"
		aria-label="View footnote"
	>
		[note]
	</button>

	<span popover id={id} style={`position-anchor: ${anchor}`} class="footnote-content">
		<slot />
	</span>
</span>

<style>
	.footnote-wrapper {
		display: inline-block;
	}

	.link-button {
		background: none;
		border: none;
		padding: 0;
		color: var(--link);
		text-decoration: underline;
		cursor: pointer;
		font-size: 0.75em;
		font-family: inherit;
		vertical-align: super;
	}

	.footnote-content:popover-open {
		display: block;
	}

	.footnote-content {
		position: absolute;

		inset: auto;
		margin: 0;

		position-area: top;

		margin-bottom: 10px;

		border: 1px solid #ccc;
		border-radius: 6px;
		padding: 10px;
		background: white;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
		width: max-content;
		max-width: min(320px, 90vw);
		font-size: 0.85em;
		line-height: 1.45;
		color: #333;
	}
</style>
